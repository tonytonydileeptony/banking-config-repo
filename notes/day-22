import java.util.concurrent.CompletableFuture;

public class ParallelExample {

    public static void main(String[] args) {

        CompletableFuture<String> user =
            CompletableFuture.supplyAsync(() -> "User Data");

        CompletableFuture<String> orders =
            CompletableFuture.supplyAsync(() -> "Order Data");

        CompletableFuture<String> payments =
            CompletableFuture.supplyAsync(() -> "Payment Data");

        CompletableFuture.allOf(user, orders, payments).join();

        System.out.println(user.join());
        System.out.println(orders.join());
        System.out.println(payments.join());
    }
}

