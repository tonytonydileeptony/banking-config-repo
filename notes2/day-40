Step 1: Outbox Entity
id="outbox_entity"
@Entity
public class OutboxEvent {

    @Id
    @GeneratedValue(strategy = GenerationType.IDENTITY)
    private Long id;

    private String eventType;

    @Column(columnDefinition = "TEXT")
    private String payload;

    private String status; // NEW, SENT

    private LocalDateTime createdAt;
}
Step 2: Repository
id="outbox_repo"
public interface OutboxRepository
        extends JpaRepository<OutboxEvent, Long> {

    List<OutboxEvent> findByStatus(String status);
}
Step 3: Save Transaction + Outbox in SAME TRANSACTION
id="save_both"
@Transactional
public void transfer(...) {

    // 1. Save transaction
    transactionRepository.save(transaction);

    // 2. Create event
    TransactionEvent event = new TransactionEvent(...);

    OutboxEvent outbox = new OutboxEvent();
    outbox.setEventType("TRANSFER_COMPLETED");
    outbox.setPayload(convertToJson(event));
    outbox.setStatus("NEW");
    outbox.setCreatedAt(LocalDateTime.now());

    outboxRepository.save(outbox);
}

✅ Both are saved in same DB transaction

Step 4: Outbox Publisher (Scheduler)
id="outbox_scheduler"
@Service
public class OutboxPublisher {

    private final OutboxRepository repository;
    private final KafkaTemplate<String, String> kafkaTemplate;

    public OutboxPublisher(OutboxRepository repository,
                           KafkaTemplate<String, String> kafkaTemplate) {
        this.repository = repository;
        this.kafkaTemplate = kafkaTemplate;
    }

    @Scheduled(fixedDelay = 5000)
    public void publishEvents() {

        List<OutboxEvent> events =
                repository.findByStatus("NEW");

        for (OutboxEvent event : events) {
            try {

                kafkaTemplate.send("transaction-events",
                        event.getPayload());

                event.setStatus("SENT");
                repository.save(event);

            } catch (Exception e) {
                System.out.println("Failed to publish event");
            }
        }
    }
}
