🟢 Step 2 – Create Versioned DTOs
public class AccountResponseV1 {
    private Long id;
    private BigDecimal balance;
}
public class AccountResponseV2 {
    private Long id;
    private BigDecimal balance;
    private String currency;
    private String accountType;
}
🟢 Step 3 – Create Versioned Controllers
✅ V1 Controller
@RestController
@RequestMapping("/api/v1/accounts")
@Tag(name = "Accounts V1", description = "Basic account APIs")
public class AccountControllerV1 {

    @Operation(summary = "Get account details (V1)")
    @GetMapping("/{id}")
    public AccountResponseV1 getAccount(@PathVariable Long id) {
        return new AccountResponseV1(id, new BigDecimal("1000"));
    }
}
✅ V2 Controller
@RestController
@RequestMapping("/api/v2/accounts")
@Tag(name = "Accounts V2", description = "Advanced account APIs")
public class AccountControllerV2 {

    @Operation(summary = "Get account details with extra fields (V2)")
    @GetMapping("/{id}")
    public AccountResponseV2 getAccount(@PathVariable Long id) {
        return new AccountResponseV2(
            id,
            new BigDecimal("1000"),
            "INR",
            "SAVINGS"
        );
    }
}
🟢 Step 4 – Swagger/OpenAPI Configuration
@Configuration
public class OpenAPIConfig {

    @Bean
    public OpenAPI bankingAPI() {
        return new OpenAPI()
            .info(new Info()
                .title("Banking API")
                .version("v1")
                .description("API documentation for Banking System"));
    }
}
🟢 Step 5 – Group APIs by Version (IMPORTANT)

👉 This is what makes you senior-level

@Bean
public GroupedOpenApi v1Api() {
    return GroupedOpenApi.builder()
        .group("v1")
        .pathsToMatch("/api/v1/**")
        .build();
}

@Bean
public GroupedOpenApi v2Api() {
    return GroupedOpenApi.builder()
        .group("v2")
        .pathsToMatch("/api/v2/**")
        .build();
}

